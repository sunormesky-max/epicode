{
  "mcpServers": {
    "epicode-memory": {
      "command": "/absolute/path/to/python",
      "args": [
        "/absolute/path/to/epicode/mcp-bridge/epicode_mcp_server.py"
      ],
      "env": {
        "EPICODE_API_KEY": "your_api_key_here",
        "EPICODE_BASE_URL": "https://epicode.cn"
      }
    }
  }
}
